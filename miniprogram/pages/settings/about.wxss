page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0;
}

/* 应用信息 */
.app-info {
  padding: 60rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #ffe4c4 0%, #ffd7a8 100%);
  margin-bottom: 24rpx;
}

.app-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 24rpx;
  color: #8c7965;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #7c3a1d;
  font-style: italic;
}

/* 功能特性 */
.features {
  padding: 32rpx;
  background: #ffffff;
  margin-bottom: 24rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
}

.feature-item:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.feature-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

/* 版本信息 */
.section {
  margin-bottom: 24rpx;
}

.list-group {
  background: #ffffff;
}

.list-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.item-label {
  font-size: 28rpx;
  color: #333333;
}

.item-value {
  font-size: 28rpx;
  color: #666666;
}

.item-arrow {
  font-size: 48rpx;
  color: #c8c8c8;
  font-weight: 300;
  line-height: 1;
}

/* 版权信息 */
.copyright {
  padding: 40rpx 32rpx;
  text-align: center;
}

.copyright-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 2;
}
