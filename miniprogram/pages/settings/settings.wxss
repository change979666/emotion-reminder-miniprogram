page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 20rpx 0 40rpx;
  box-sizing: border-box;
}

/* 用户信息卡片 */
.user-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ffe4c4 0%, #ffd7a8 100%);
  box-shadow: 0 4rpx 16rpx rgba(217, 119, 6, 0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
}

.user-id {
  font-size: 24rpx;
  color: #7a6854;
}

/* 分组标题 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 列表组 */
.list-group {
  margin: 0 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  overflow: hidden;
}

.list-item {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  transition: background-color 0.2s ease;
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.list-item-hover {
  background-color: #f8f8f8;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.item-icon {
  font-size: 36rpx;
  width: 40rpx;
  text-align: center;
}

.item-text {
  font-size: 28rpx;
  color: #333333;
}

.item-arrow {
  font-size: 48rpx;
  color: #c8c8c8;
  font-weight: 300;
  line-height: 1;
}

/* 危险操作 */
.list-item--danger {
  justify-content: center;
}

.list-item--danger .item-text {
  color: #ef4444;
  font-weight: 500;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 40rpx;
  padding-bottom: 20rpx;
}
