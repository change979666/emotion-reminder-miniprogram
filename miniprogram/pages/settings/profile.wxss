page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0;
}

.form-section {
  margin-bottom: 24rpx;
  background: #ffffff;
}

.form-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item--column {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.avatar-btn {
  padding: 0;
  border: none;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #f0f0f0;
}

.avatar-tip {
  font-size: 22rpx;
  color: #666666;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666666;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  box-sizing: border-box;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 40rpx;
}
