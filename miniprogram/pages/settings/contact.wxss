page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0 40rpx;
}

/* 联系信息 */
.contact-info {
  padding: 48rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #ffe4c4 0%, #ffd7a8 100%);
  margin-bottom: 24rpx;
}

.info-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 12rpx;
}

.info-desc {
  font-size: 24rpx;
  color: #7c3a1d;
  line-height: 1.8;
}

/* 表单 */
.form-section {
  margin-bottom: 24rpx;
  background: #ffffff;
}

.form-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item--column {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.required {
  color: #ef4444;
}

.picker-value {
  font-size: 28rpx;
  color: #666666;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666666;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  align-self: flex-end;
  font-size: 22rpx;
  color: #999999;
}

/* 提交按钮 */
.submit-section {
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.4);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  transform: scale(0.98);
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 32rpx;
  line-height: 1.8;
}
