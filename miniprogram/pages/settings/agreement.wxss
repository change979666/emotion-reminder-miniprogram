page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 32rpx;
}

.article {
  line-height: 1.8;
}

.article-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.article-date {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 40rpx;
}

.article-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 2;
  white-space: pre-wrap;
}

.article-footer {
  margin-top: 40rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  line-height: 1.8;
}
