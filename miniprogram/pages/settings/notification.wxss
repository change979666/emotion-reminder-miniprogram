page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #8c8c8c;
  font-weight: 500;
}

.list-group {
  background: #ffffff;
}

.list-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333333;
}

.item-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.time-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-value {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666666;
}

.time-separator {
  font-size: 24rpx;
  color: #999999;
}
