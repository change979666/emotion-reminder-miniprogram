page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #8c8c8c;
  font-weight: 500;
}

.list-group {
  background: #ffffff;
}

.list-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.list-item--column {
  flex-direction: column;
  align-items: flex-start;
  gap: 20rpx;
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.item-label {
  font-size: 28rpx;
  color: #333333;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.picker-value {
  font-size: 28rpx;
  color: #666666;
}

.font-size-group {
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.font-size-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.font-size-item.active {
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.3);
}
