page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 0;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.list-group {
  background: #ffffff;
}

.list-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.list-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #f0f0f0;
}

.item-label {
  font-size: 28rpx;
  color: #333333;
}

.item-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #666666;
}

.item-input {
  flex: 1;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  font-size: 26rpx;
  color: #333;
}

.copy-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  font-size: 24rpx;
  color: #d97706;
}

.bind-btn {
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #ffffff;
  font-size: 24rpx;
  border: none;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 40rpx;
}
