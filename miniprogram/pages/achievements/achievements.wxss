page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #fef3c7 0%, #fef9e7 50%, #fce7f3 100%);
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

/* 成就概览卡片 */
.overview-card {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.15));
  border: 2rpx solid rgba(251, 191, 36, 0.3);
  box-shadow: 0 18rpx 40rpx rgba(245, 158, 11, 0.15);
  margin-bottom: 32rpx;
}

.overview-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.overview-icon {
  font-size: 60rpx;
  line-height: 1;
}

.overview-content {
  flex: 1;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #78350f;
  margin-bottom: 8rpx;
}

.overview-subtitle {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.overview-stats {
  display: flex;
  gap: 16rpx;
}

.stat-box {
  flex: 1;
  text-align: center;
  padding: 20rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  border: 1px solid rgba(251, 191, 36, 0.2);
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #f59e0b;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #92400e;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.06);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #92400e;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.filter-tab--active {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(251, 191, 36, 0.3);
}

/* 成就列表 */
.achievements-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.achievement-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
}

.achievement-card--completed {
  border-color: rgba(34, 197, 94, 0.3);
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.08), rgba(22, 163, 74, 0.08));
}

.achievement-card--inProgress {
  border-color: rgba(59, 130, 246, 0.3);
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(37, 99, 235, 0.08));
}

.achievement-card--locked {
  opacity: 0.5;
  border-color: rgba(156, 163, 175, 0.3);
}

.achievement-icon-large {
  font-size: 56rpx;
  line-height: 1;
}

.achievement-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.achievement-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.achievement-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.achievement-progress-bar {
  margin-top: 8rpx;
}

.progress-track {
  height: 8rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 20rpx;
  color: #f59e0b;
  text-align: right;
}

.achievement-reward {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.15));
  border-radius: 12rpx;
  margin-top: 4rpx;
}

.reward-icon {
  font-size: 20rpx;
}

.reward-text {
  font-size: 20rpx;
  color: #d97706;
}

.achievement-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(34, 197, 94, 0.3);
}

.badge-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}
