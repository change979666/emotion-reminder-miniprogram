page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top left, #f9e7fe 0, #fdfcff 40%, #e7f2ff 100%);
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(126, 209, 255, 0.12), rgba(210, 172, 255, 0.35));
  box-shadow: 0 18rpx 40rpx rgba(78, 93, 120, 0.12);
  color: #20263a;
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #4f5b76;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.template-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 999rpx;
  border: 1px solid rgba(126, 209, 255, 0.3);
  transition: all 0.3s ease;
}

.template-link:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.8);
}

.template-icon {
  font-size: 24rpx;
}

.template-text {
  font-size: 22rpx;
  color: #5b7199;
}

.form-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 28rpx 24rpx 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(55, 69, 100, 0.08);
  backdrop-filter: blur(10px);
}

.field {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.field-label {
  font-size: 26rpx;
  color: #252a3c;
  margin-bottom: 12rpx;
}

.field-input {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(28, 33, 53, 0.06);
  background-color: rgba(245, 247, 252, 0.9);
  font-size: 26rpx;
}

.field-textarea {
  min-height: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(28, 33, 53, 0.06);
  background-color: rgba(245, 247, 252, 0.9);
  font-size: 26rpx;
}

.field-helper {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa3b8;
  text-align: right;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.auto-save-hint {
  color: #10b981;
  font-size: 20rpx;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.field-helper-tip {
  color: #5661ff;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.picker-display {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(28, 33, 53, 0.06);
  background-color: rgba(245, 247, 252, 0.9);
  font-size: 26rpx;
  color: #4a5570;
}

.mood-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mood-tag {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4d5870;
  background: rgba(245, 247, 252, 0.9);
  border: 1px solid transparent;
}

.mood-tag--active {
  color: #1b1952;
  background: linear-gradient(135deg, #f4e8ff, #dde9ff);
  border-color: rgba(87, 112, 255, 0.28);
  box-shadow: 0 10rpx 20rpx rgba(87, 112, 255, 0.18);
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag-add-btn {
  padding: 0 18rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #fff;
  font-size: 24rpx;
  border: none;
}

.tag-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1f2;
  color: #d97706;
  font-size: 22rpx;
}

.location-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-text {
  font-size: 22rpx;
  color: #7a83a2;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(to top, rgba(248, 249, 255, 0.96), rgba(248, 249, 255, 0));
}

.primary-btn {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5661ff, #ac7bff);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 18rpx 40rpx rgba(100, 108, 255, 0.4);
}

.primary-btn[disabled] {
  background: linear-gradient(135deg, #c4c8f5, #d4c3f5);
  box-shadow: none;
}

.bottom-safe {
  height: 100rpx;
}

/* 时光彩蛋卡片 */
.capsule-card {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(55, 69, 100, 0.08);
  backdrop-filter: blur(10px);
}

.capsule-header {
  margin-bottom: 16rpx;
}

.capsule-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #252a3c;
  margin-bottom: 6rpx;
}

.capsule-subtitle {
  font-size: 22rpx;
  color: #757fa0;
  line-height: 1.5;
}

.capsule-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.capsule-item {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(245, 247, 252, 0.9), rgba(239, 242, 252, 0.9));
  border: 1px solid rgba(87, 112, 255, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s ease;
}

.capsule-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(240, 243, 255, 0.9), rgba(233, 237, 255, 0.9));
}

.capsule-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #5661ff, #ac7bff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.capsule-content {
  flex: 1;
}

.capsule-text {
  font-size: 26rpx;
  color: #4a5570;
  font-weight: 500;
}

/* AI 辅助工具按钮 */
.ai-tools {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.ai-tool-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.ai-tool-btn:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.35);
}

.ai-tool-btn[disabled] {
  background: linear-gradient(135deg, #cbd5e0 0%, #a0aec0 100%);
  box-shadow: none;
  opacity: 0.6;
}

/* 信件模板弹窗 */
.template-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

.template-content {
  width: 90%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.template-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.template-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 4rpx 12rpx;
}

.template-list {
  max-height: 50vh;
  overflow-y: auto;
}

.template-item {
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.08), rgba(196, 181, 253, 0.08));
  border: 1px solid rgba(167, 139, 250, 0.2);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.template-item:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.15), rgba(196, 181, 253, 0.15));
}

.template-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5b21b6;
  margin-bottom: 8rpx;
}

.template-item-preview {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  white-space: pre-wrap;
}
