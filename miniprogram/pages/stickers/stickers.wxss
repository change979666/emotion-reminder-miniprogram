page {
  height: 100%;
}

.scrollarea {
  height: 100%;
}

.page {
  min-height: 100%;
  padding: 20rpx;
  background: linear-gradient(180deg, #f8f9ff 0%, #fdfcff 100%);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 99, 255, 0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #6c63ff;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #f0f0f0;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 8rpx 0;
}

.tab-item {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  background: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-item--active {
  background: linear-gradient(135deg, #6c63ff, #8b7eff);
  color: white;
  font-weight: bold;
  transform: scale(1.05);
}

/* 贴纸网格 */
.stickers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.sticker-card {
  position: relative;
  aspect-ratio: 1;
  background: white;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  overflow: hidden;
}

.sticker-card--owned {
  cursor: pointer;
}

.sticker-card--owned:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.08);
}

.sticker-card--locked {
  background: #f5f5f5;
  opacity: 0.6;
}

.sticker-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8787);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: bold;
  z-index: 10;
  box-shadow: 0 4rpx 8rpx rgba(255, 107, 107, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

.sticker-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.sticker-name {
  font-size: 22rpx;
  color: #333;
  text-align: center;
  padding: 0 8rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sticker-lock {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(4rpx);
}

.lock-icon {
  font-size: 48rpx;
  opacity: 0.5;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sticker-detail {
  position: fixed;
  bottom: -100%;
  left: 0;
  right: 0;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx 80rpx;
  z-index: 1001;
  transition: bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 80vh;
  overflow-y: auto;
}

.sticker-detail--show {
  bottom: 0;
}

.detail-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.detail-emoji {
  font-size: 120rpx;
  line-height: 1;
}

.detail-close {
  position: absolute;
  top: -8rpx;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

.detail-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.detail-quote {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
  padding: 0 40rpx;
}

.detail-info {
  background: #f8f9ff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(108, 99, 255, 0.1);
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-item:first-child {
  padding-top: 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.detail-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7e6;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #ffd666;
}

.hint-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.hint-text {
  flex: 1;
  font-size: 26rpx;
  color: #d48806;
  line-height: 1.5;
}

/* 深色主题 */
.dark .page {
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}

.dark .stats-card {
  background: #1e1e2e;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.dark .stat-number {
  color: #8b7eff;
}

.dark .stat-label {
  color: #888;
}

.dark .stat-divider {
  background: #333;
}

.dark .tab-item {
  background: #1e1e2e;
  color: #aaa;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.dark .sticker-card {
  background: #1e1e2e;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.3);
}

.dark .sticker-card--locked {
  background: #2a2a3a;
}

.dark .sticker-name {
  color: #ddd;
}

.dark .empty-text {
  color: #777;
}

.dark .sticker-detail {
  background: #1e1e2e;
}

.dark .detail-close {
  background: #2a2a3a;
  color: #aaa;
}

.dark .detail-name {
  color: #eee;
}

.dark .detail-quote {
  color: #aaa;
}

.dark .detail-info {
  background: #252535;
}

.dark .info-item {
  border-bottom-color: rgba(139, 126, 255, 0.1);
}

.dark .info-label {
  color: #888;
}

.dark .info-value {
  color: #ddd;
}

.dark .detail-hint {
  background: #2a2415;
  border-color: #d48806;
}

.dark .hint-text {
  color: #ffa940;
}
