page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at top left, #f9e7fe 0, #fdfcff 40%, #e7f2ff 100%);
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(126, 209, 255, 0.12), rgba(210, 172, 255, 0.35));
  box-shadow: 0 18rpx 40rpx rgba(78, 93, 120, 0.12);
  color: #20263a;
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #4f5b76;
  line-height: 1.6;
}

.form-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 28rpx 24rpx 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(55, 69, 100, 0.08);
  backdrop-filter: blur(10px);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #252a3c;
  margin-bottom: 12rpx;
}

.field-input {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(28, 33, 53, 0.06);
  background-color: rgba(245, 247, 252, 0.9);
  font-size: 26rpx;
}

.field-textarea {
  min-height: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(28, 33, 53, 0.06);
  background-color: rgba(245, 247, 252, 0.9);
  font-size: 26rpx;
}

.field-helper {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa3b8;
  text-align: right;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(to top, rgba(248, 249, 255, 0.96), rgba(248, 249, 255, 0));
}

.primary-btn {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5661ff, #ac7bff);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 18rpx 40rpx rgba(100, 108, 255, 0.4);
}

.primary-btn[disabled] {
  background: linear-gradient(135deg, #c4c8f5, #d4c3f5);
  box-shadow: none;
}

.bottom-safe {
  height: 140rpx;
}

/* 媒体上传网格 */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-image,
.media-video-player {
  width: 100%;
  height: 100%;
  display: block;
}

.media-video {
  background: #000;
}

.media-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(245, 247, 252, 0.9);
  border: 2px dashed rgba(155, 163, 184, 0.3);
  cursor: pointer;
}

.add-icon {
  font-size: 48rpx;
  color: #9aa3b8;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #9aa3b8;
}

.media-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.delete-icon {
  font-size: 36rpx;
  color: #fff;
  line-height: 1;
  font-weight: 300;
}

