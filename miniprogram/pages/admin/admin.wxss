page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f3e7ff 0%, #fef3e7 100%);
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 32rpx 40rpx;
}

/* 头部 */
.header {
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 24rpx;
  color: #7c3a1d;
  line-height: 1.6;
}

/* 分区 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  padding: 0 12rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

/* 卡片 */
.card {
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-item {
  margin-bottom: 24rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

/* 按钮 */
.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.4);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn--danger {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.4);
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

/* 状态卡片 */
.status-card {
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-card--success {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
}

.status-card--error {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.status-icon {
  font-size: 40rpx;
}

.status-message {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #2c2c2c;
}
