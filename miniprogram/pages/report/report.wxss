page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fef3c7 0%, #fdfcff 30%, #e0e7ff 100%);
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

/* 头部卡片 */
.hero-card {
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(253, 224, 71, 0.4), rgba(251, 191, 36, 0.3));
  box-shadow: 0 18rpx 40rpx rgba(251, 191, 36, 0.2);
  text-align: center;
  margin-bottom: 24rpx;
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #78350f;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #92400e;
}

/* 区块卡片 */
.section-card {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 32rpx rgba(120, 53, 15, 0.08);
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #78350f;
  margin-bottom: 20rpx;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-box {
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #78350f;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #92400e;
}

/* 关键词云 */
.keywords-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.keyword-tag {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fde68a, #fbbf24);
  color: #78350f;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.keyword-count {
  font-size: 20rpx;
  color: #92400e;
  font-weight: 400;
}

/* 情绪卡片 */
.mood-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(196, 181, 253, 0.4), rgba(167, 139, 250, 0.3));
  text-align: center;
}

.mood-text {
  font-size: 26rpx;
  color: #5b21b6;
  font-weight: 500;
}

/* 故事卡片 */
.story-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(254, 202, 202, 0.4), rgba(252, 165, 165, 0.3));
  border-left: 4rpx solid #f87171;
}

.story-text {
  font-size: 26rpx;
  color: #7f1d1d;
  line-height: 1.8;
}

/* 帮助卡片 */
.help-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.help-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(254, 243, 199, 0.5);
}

.help-label {
  font-size: 24rpx;
  color: #92400e;
}

.help-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #78350f;
}

/* 分享按钮 */
.share-section {
  margin-top: 24rpx;
}

.share-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 18rpx 40rpx rgba(251, 191, 36, 0.4);
}

.bottom-safe {
  height: 60rpx;
}
