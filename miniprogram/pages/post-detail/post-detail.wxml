<navigation-bar title="详情" back="{{true}}" color="black" background="#fdfcff"></navigation-bar>
<scroll-view 
  class="scrollarea" 
  scroll-y 
  refresher-enabled 
  refresher-triggered="{{refreshing}}" 
  bindrefresherrefresh="onRefresh"
  bindscrolltolower="onLoadMore"
  lower-threshold="100"
>
  <view class="page {{themeClass}}">
    <!-- 加载提示 -->
    <view class="loading-hint" wx:if="{{!post && !loadError}}">
      <view class="loading-icon">📨</view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 错误提示 -->
    <view class="error-hint" wx:if="{{loadError}}">
      <view class="error-icon">⚠️</view>
      <view class="error-text">{{loadError}}</view>
    </view>
    
    <!-- 信件内容卡片 -->
    <view class="letter-card" wx:if="{{post}}">
      <view class="letter-header">
        <view class="letter-badge">💬 来自陌生人的信</view>
        <view class="letter-date">{{post.targetDate}}</view>
      </view>
      
      <view class="letter-title">{{post.title}}</view>
      <view class="letter-content">{{post.content}}</view>
      
      <!-- 图片展示 -->
      <view class="letter-images" wx:if="{{post.images && post.images.length}}">
        <block wx:for="{{post.images}}" wx:key="index" wx:for-item="img">
          <image class="letter-image" src="{{img}}" mode="widthFix" bindtap="onPreviewImage" data-url="{{img}}" data-urls="{{post.images}}"></image>
        </block>
      </view>
      
      <!-- 视频展示 -->
      <view class="letter-video" wx:if="{{post.videoPath}}">
        <video class="video-player" src="{{post.videoPath}}" poster="{{post.videoThumb}}" controls show-center-play-btn></video>
      </view>
      
      <view class="letter-meta">
        <view class="letter-time">创建于 {{post.createdAtText}}</view>
        <view class="letter-mood" wx:if="{{post.mood}}">🌿 {{post.moodLabel || '当时的心情'}}</view>
      </view>
    </view>

    <!-- 快捷互动按钮 -->
    <view class="quick-actions" wx:if="{{post}}">
      <view class="quick-actions-title">💕 给TA一些温暖</view>
      <view class="quick-btns">
        <view class="quick-btn" data-tag-id="hug" bindtap="onTagClick">
          <text class="quick-emoji">🤗</text>
          <text class="quick-text">抱一抱</text>
        </view>
        <view class="quick-btn" data-tag-id="understand" bindtap="onTagClick">
          <text class="quick-emoji">🫶</text>
          <text class="quick-text">我懂你</text>
        </view>
        <view class="quick-btn" data-tag-id="cheer" bindtap="onTagClick">
          <text class="quick-emoji">💪</text>
          <text class="quick-text">加油</text>
        </view>
        <view class="quick-btn" data-tag-id="warm" bindtap="onTagClick">
          <text class="quick-emoji">☀️</text>
          <text class="quick-text">好温暖</text>
        </view>
      </view>
      <view class="interaction-stats">
        <view class="stat-item">
          <text class="stat-icon">❤️</text>
          <text class="stat-text">共鸣 {{post.likeCount}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">💬</text>
          <text class="stat-text">{{post.commentCount || 0}}条评论</text>
        </view>
      </view>
    </view>

    <!-- 评论区域 -->
    <view class="comments-section">
      <view class="comments-header">
        <view class="comments-title">💬 评论区</view>
        <view class="comments-count">{{comments.length}}条评论</view>
      </view>
      
      <!-- 评论输入框 -->
      <view class="comment-input-box">
        <textarea 
          class="comment-textarea" 
          placeholder="说说你的想法...（最多100字）" 
          maxlength="100"
          value="{{inputText}}"
          bindinput="onInput"
          auto-height
          placeholder-class="input-placeholder"
        />
        <button 
          class="comment-send-btn {{inputText.length > 0 ? 'comment-send-btn--active' : ''}}" 
          bindtap="onSend"
          disabled="{{inputText.length === 0}}"
        >
          发送
        </button>
      </view>
      
      <!-- 评论排序 -->
      <view class="comment-sort-bar">
        <view class="sort-tabs">
          <view 
            class="sort-tab {{sortType === 'latest' ? 'sort-tab--active' : ''}}" 
            data-type="latest" 
            bindtap="onSortChange"
          >
            最新
          </view>
          <view 
            class="sort-tab {{sortType === 'hot' ? 'sort-tab--active' : ''}}" 
            data-type="hot" 
            bindtap="onSortChange"
          >
            最热
          </view>
        </view>
      </view>
      <block wx:if="{{comments.length > 0}}">
        <view class="comment-list">
          <block wx:for="{{comments}}" wx:key="id">
            <view class="comment-card">
              <view class="comment-header">
                <view class="comment-avatar">👤</view>
                <view class="comment-user">
                  <view class="comment-username">匿名用户{{item.anonymousId}}</view>
                  <view class="comment-time">{{item.timeText}}</view>
                </view>
                <view class="comment-like" data-id="{{item.id}}" bindtap="onCommentLike">
                  <text class="like-icon">{{item.userLiked ? '❤️' : '🤍'}}</text>
                  <text class="like-count">{{item.likeCount}}</text>
                </view>
              </view>
              <view class="comment-content">{{item.text}}</view>
              
              <!-- 回复列表 -->
              <view class="replies-section" wx:if="{{item.replies && item.replies.length > 0}}">
                <block wx:for="{{item.replies}}" wx:key="id" wx:for-item="reply">
                  <view class="reply-item">
                    <text class="reply-user">匿名用户{{reply.anonymousId}}:</text>
                    <text class="reply-content">{{reply.text}}</text>
                  </view>
                </block>
              </view>
              
              <view class="comment-action" data-id="{{item.id}}" bindtap="onShowReplyInput">
                <text class="action-icon">↩️</text>
                <text class="action-text">回复</text>
              </view>
            </view>
          </block>
        </view>
        
        <!-- 加载更多提示 -->
        <view class="load-more" wx:if="{{hasMore}}">
          <view class="load-more-text">{{loading ? '加载中...' : '上拉加载更多'}}</view>
        </view>
        <view class="load-end" wx:else>
          <view class="load-end-text">没有更多评论了</view>
        </view>
      </block>
      
      <block wx:else>
        <view class="empty-comments">
          <view class="empty-icon">💬</view>
          <view class="empty-text">还没有评论，快来抢沙发吧</view>
        </view>
      </block>
    </view>
  </view>
</scroll-view>
