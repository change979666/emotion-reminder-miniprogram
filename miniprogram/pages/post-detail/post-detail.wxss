page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f6f3;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  padding-bottom: 24rpx;
}

.page {
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  min-height: 100vh;
}

/* 加载和错误提示 */
.loading-hint,
.error-hint {
  padding: 80rpx 24rpx;
  text-align: center;
}

.loading-icon,
.error-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.loading-text,
.error-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.error-text {
  color: #ef4444;
}

/* 信件内容卡片 */
.letter-card {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.15);
  border: 2rpx solid rgba(251, 191, 36, 0.3);
}

.letter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.letter-badge {
  padding: 8rpx 16rpx;
  background: rgba(217, 119, 6, 0.15);
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #92400e;
  font-weight: 500;
}

.letter-date {
  font-size: 24rpx;
  color: #a16207;
}

.letter-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #78350f;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.letter-content {
  font-size: 30rpx;
  color: #92400e;
  line-height: 1.8;
  margin-bottom: 24rpx;
  white-space: pre-wrap;
}

/* 图片展示 */
.letter-images {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.letter-image {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 视频展示 */
.letter-video {
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.video-player {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
}

.letter-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(217, 119, 6, 0.2);
}

.letter-time {
  font-size: 24rpx;
  color: #a16207;
}

.letter-mood {
  font-size: 24rpx;
  color: #92400e;
  background: rgba(254, 243, 199, 0.6);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

/* 互动区域 */
.interaction-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.interaction-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.interaction-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s ease;
}

.action-btn--active {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-color: #fbbf24;
}

.action-btn .action-icon {
  font-size: 32rpx;
}

.action-btn .action-text {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.action-btn--active .action-text {
  color: #92400e;
}

/* 快捷操作按钮 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 12rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 16rpx;
  border: 2rpx solid #fbbf24;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(251, 191, 36, 0.2);
}

.quick-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(251, 191, 36, 0.3);
}

.quick-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.quick-text {
  font-size: 24rpx;
  color: #92400e;
  font-weight: 500;
  white-space: nowrap;
}

/* 互动统计 */
.interaction-stats {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-text {
  font-size: 26rpx;
  color: #6b7280;
}

/* 帖子卡片 */
.post-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.post-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.post-date {
  font-size: 24rpx;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.post-content {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  border: 2rpx solid #e5e7eb;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.tag-item--active {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-color: #fbbf24;
}

.tag-emoji {
  font-size: 28rpx;
}

.tag-text {
  color: #6b7280;
  font-weight: 500;
}

.tag-item--active .tag-text {
  color: #92400e;
}

.tag-count {
  color: #9ca3af;
  font-size: 22rpx;
}

.tag-item--active .tag-count {
  color: #d97706;
  font-weight: 600;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.post-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.post-actions {
  display: flex;
  gap: 32rpx;
}

.action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  transition: all 0.3s ease;
}

.action--active {
  color: #ef4444;
}

.action-icon {
  font-size: 32rpx;
}

.action-text {
  font-weight: 500;
}

/* 评论排序 */
.comment-sort {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.sort-tabs {
  display: flex;
  gap: 24rpx;
}

.sort-tab {
  font-size: 28rpx;
  color: #6b7280;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.sort-tab--active {
  color: #8b5cf6;
  font-weight: 600;
}

.sort-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #8b5cf6, #7c3aed);
  border-radius: 2rpx;
}

.sort-count {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 评论区域 */
.comments-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  min-height: 400rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.comments-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.comments-count {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 评论输入框 */
.comment-input-box {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #e5e7eb;
}

.input-container {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.comment-textarea {
  flex: 1;
  padding: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  max-height: 200rpx;
  border: 2rpx solid #e5e7eb;
}

.input-placeholder {
  color: #9ca3af;
}

.comment-send-btn {
  padding: 16rpx 32rpx;
  background: #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #9ca3af;
  border: none;
  transition: all 0.3s ease;
}

.comment-send-btn--active {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-weight: 500;
}

.comment-send-btn::after {
  border: none;
}

/* 评论排序栏 */
.comment-sort-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-card {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.comment-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.comment-user {
  flex: 1;
}

.comment-username {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  transition: all 0.3s ease;
}

.like-icon {
  font-size: 28rpx;
}

.like-count {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.comment-content {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding-left: 80rpx;
}

.replies-section {
  padding-left: 80rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reply-item {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
}

.reply-user {
  color: #8b5cf6;
  font-weight: 600;
  margin-right: 8rpx;
}

.reply-content {
  color: #4b5563;
}

.comment-action {
  padding-left: 80rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 8rpx 0;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-weight: 500;
}

/* 空状态 */
.empty-comments {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 加载提示 */
.load-more,
.load-end {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-text,
.load-end-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部输入栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 100;
}

.comment-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.send-btn {
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
  color: #9ca3af;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.send-btn--active {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  color: #fff;
}

.send-btn--active:active {
  transform: scale(0.95);
}

/* 回复提示条 */
.reply-bar {
  position: fixed;
  bottom: 100rpx;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  background: #fef3c7;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #fde68a;
  z-index: 99;
}

.reply-info {
  flex: 1;
  font-size: 26rpx;
}

.reply-label {
  color: #92400e;
}

.reply-target {
  color: #d97706;
  font-weight: 600;
}

.reply-cancel {
  font-size: 32rpx;
  color: #d97706;
  padding: 8rpx;
}

