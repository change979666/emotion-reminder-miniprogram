page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff7ed;
}

.scrollarea {
  flex: 1;
  height: 100%;
  overflow-y: auto;
}

.page {
  padding: 24rpx;
}

.help-status-section {
  margin-bottom: 24rpx;
}

.help-status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.help-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.help-card-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.help-card-icon {
  font-size: 30rpx;
}

.help-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.help-card-content {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.help-card-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.help-label {
  font-size: 22rpx;
  color: #6b7280;
}

.help-title {
  font-size: 26rpx;
  color: #111827;
  line-height: 1.35;
}

.help-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.help-status-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.help-status-btn.waiting {
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
}

.help-status-btn.has-reply {
  background: rgba(16, 185, 129, 0.14);
  color: #059669;
}

.help-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.help-status-empty {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.06);
}

.help-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.help-empty-sub {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 14rpx;
}

.help-empty-btn {
  height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #111827;
  color: #fff;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #7c3a1d;
}

.summary-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(217, 119, 6, 0.18);
  color: #7c3a1d;
  font-size: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.msg-item {
  position: relative;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(217, 119, 6, 0.12);
}

.msg-item--unread {
  border: 1px solid rgba(239, 68, 68, 0.25);
}

.msg-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.msg-type {
  font-size: 26rpx;
  color: #7c3a1d;
  font-weight: 600;
}

.msg-time {
  font-size: 22rpx;
  color: rgba(124, 58, 29, 0.55);
}

.msg-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.msg-main {
  font-size: 24rpx;
  color: rgba(124, 58, 29, 0.92);
  line-height: 1.6;
}

.msg-sub {
  font-size: 22rpx;
  color: rgba(124, 58, 29, 0.7);
}

.msg-dot {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ef4444;
}

.empty {
  padding: 60rpx 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(217, 119, 6, 0.12);
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
  line-height: 1;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #7c3a1d;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: rgba(124, 58, 29, 0.72);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.4);
}

.empty-btn::after {
  border: none;
}
